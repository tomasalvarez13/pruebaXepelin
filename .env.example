# ── API ──────────────────────────────────────────
DATABASE_URL=postgresql://xepelin:xepelin@localhost:5432/xepelin_crm
JWT_SECRET=change-me-to-a-random-secret
PORT=4000
CORS_ORIGIN=http://localhost:3000
AUTH_MODE=mock  # "mock" = skip Google OAuth, use seeded KAM; "google" = real OAuth

# ── WEB ──────────────────────────────────────────
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-random-secret  # must match API's JWT_SECRET
